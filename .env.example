# Copy to .env and fill in real values. .env is gitignored.

# Optional: used if you later wire an LLM into the pipeline
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Required only for the `gemini` summarization backend (second-pass abbreviation).
# The `local-hub` and `fake` backends need no key.
GOOGLE_API_KEY=

# Optional: log level
LOG_LEVEL=INFO
