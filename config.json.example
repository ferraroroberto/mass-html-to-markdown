{
  "paths": {
    "html_input_dir": "data/html",
    "markdown_output_dir": "data/markdown",
    "database_path": "data/db/comparator.db",
    "log_dir": "tmp/logs"
  },
  "ingestion": {
    "profile": "data/profiles/default.json",
    "filename_pattern": "(?P<product_a>[^_]+)_vs_(?P<product_b>[^.]+)\\.html"
  },
  "markdown": {
    "include_search_keywords": true,
    "include_overview_paragraph": true
  },
  "summarization": {
    "word_limit": 40,
    "backend": "local-hub",
    "gemini_model": "gemini-2.5-pro",
    "hub_model": "claude-haiku-4-5",
    "hub_base_url": "http://127.0.0.1:8000"
  },
  "app": {
    "title": "Product Comparator — Admin"
  }
}
